# Copy to .env and adapt:  cp .env.example .env
# .env is read by Docker Compose and must never be committed (it is in .gitignore).

# --- MiniReachy daemon (runs natively on the HOST, not in Docker) ---------------------
# URL of the daemon as seen FROM THE CONTAINER. On Docker Desktop (Windows/macOS) and on
# Linux with the extra_hosts entry of compose.yaml, host.docker.internal is the host.
MINIREACHY_BASE_URL=http://host.docker.internal:8000
# Seconds
MINIREACHY_CONNECT_TIMEOUT=3
MINIREACHY_READ_TIMEOUT=15
# Retries for read-only (GET) requests only. Commands are never retried.
MINIREACHY_GET_RETRIES=1
# Responses larger than this are discarded (bytes). The app catalogue has its own limit.
MINIREACHY_MAX_RESPONSE_BYTES=2000000
MINIREACHY_MAX_APP_LIST_BYTES=10000000

# --- MCP server ---------------------------------------------------------------------
# Port published on the HOST (always bound to 127.0.0.1 by compose.yaml).
MCP_PUBLISH_PORT=8765
MCP_PATH=/mcp
# Host headers accepted (DNS-rebinding protection). Add your hostname if you proxy the server.
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*,minireachy-mcp:*
# Optional static bearer token (>= 24 chars) required on /mcp. Empty = no auth (local use only).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=
LOG_LEVEL=INFO

# --- Safety -------------------------------------------------------------------------
# Motion, motor mode, speaker output, starting apps. Default: refused.
ENABLE_PHYSICAL_ACTIONS=false
# Daemon start/stop/restart, app install/remove/update, media release, audio DSP writes.
ENABLE_ADMIN_ACTIONS=false
# Camera images and microphone listening (privacy). Default: refused.
ENABLE_PERCEPTION=false
# Upload size limit for upload_sound (bytes)
MAX_SOUND_UPLOAD_BYTES=5000000

# MCP-side motion guard rails for goto_pose (NOT robot hardware specifications).
LIMIT_HEAD_TRANSLATION_M=0.03
LIMIT_HEAD_ROLL_RAD=0.6
LIMIT_HEAD_PITCH_RAD=0.6
LIMIT_HEAD_YAW_RAD=1.2
LIMIT_BODY_YAW_RAD=1.5
LIMIT_ANTENNA_RAD=3.0
LIMIT_MIN_MOVE_DURATION_S=0.3
LIMIT_MAX_MOVE_DURATION_S=10
# Average head angular speed (rad/s) from the present pose to the target.
LIMIT_HEAD_SPEED_RAD_S=2.0

# --- Perception and voice (WebRTC stream of the daemon + local models) ----------------
# Signalling server of the daemon's GStreamer media server, as seen from the container.
MEDIA_SIGNALLING_URL=ws://host.docker.internal:8443
MEDIA_CONNECT_TIMEOUT=25
# Close the camera/microphone stream after this many seconds without use (0 = never). While it
# is open, frames are decoded and the last minute of microphone audio is kept in memory.
# It reopens on the next perception or voice call (about 3 s).
MEDIA_IDLE_DISCONNECT_S=300
# Speech-to-text (faster-whisper "small", baked into the image)
STT_LANGUAGE=fr
STT_BEAM_SIZE=5
# Text-to-speech (Piper, baked into the image): French voice "siwis" by default, English
# voice "lessac" when a tool is called with language="en". Both are loaded by the warm-up,
# so switching language costs nothing during a conversation. Empty disables the English voice.
TTS_VOICE_PATH_EN=/opt/models/piper/en_US-lessac-medium.onnx
# >1 = slower speech
TTS_LENGTH_SCALE=1.0
# Voice output: auto (WebRTC stream when perception is enabled, else daemon play_sound),
# webrtc, or daemon (upload + /api/media/play_sound, ~1 s slower per sentence)
SPEECH_OUTPUT=auto
# End of utterance after this silence (ms); speculative transcription starts at the early value.
# 700 cut people off at their natural pauses in a real conversation (2026-10-15); 1100 avoids it
# for about +0.4 s per turn.
LISTEN_SILENCE_MS=1100
LISTEN_EARLY_SILENCE_MS=300
# Load speech models and open the media stream in the background at startup
MEDIA_WARMUP=true
